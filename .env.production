# TenderAI Kazakhstan - Production Environment Configuration

NODE_ENV=production
PORT=3000

# PostgreSQL Database Connection
DATABASE_URL="postgresql://postgres:postgres_secure_pass_2026@localhost:5432/tender_db?schema=public"

# Redis Connection (BullMQ & Cache)
REDIS_URL="redis://localhost:6379"

# Kaspi Pay Acquiring Security Secret (HMAC-SHA256)
KASPI_PAY_SECRET_KEY="kazit_kaspi_secret_key_prod_2026"
KASPI_PAY_MERCHANT_ID="KAZIT_SERVICE_PROD"

# Telegram Bot Integration (@TenderAI_KZ_bot)
TELEGRAM_BOT_TOKEN="your_production_telegram_bot_token"

# Google Gemini RAG API Key
GEMINI_API_KEY="your_production_gemini_api_key"

# Официальный API портала Госзакупок РК (goszakup.gov.kz GraphQL API v3)
GOSZAKUP_API_TOKEN="your_goszakup_graphql_api_token"

