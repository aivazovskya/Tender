datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum ProcurementMethod {
  OPEN_TENDER
  AUCTION
  PRICE_PROPOSAL
  SINGLE_SOURCE
}

enum TenderStatus {
  ACTIVE
  CLOSED
  CANCELLED
  SUSPENDED
}

enum RiskScoringStatus {
  NOT_SCORED
  DEFAULT_ADAPTER
  AI_SCORED
}

enum DataSourceType {
  API
  SCRAPER
}

enum ScraperRenderMode {
  STATIC
  JS_RENDERED
}

enum HealthStatus {
  HEALTHY
  DEGRADED
  DOWN
}

enum KanbanStage {
  UNDER_REVIEW
  PREPARING_BID
  SUBMITTED
  WON
  LOST
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
}

model Tender {
  id                         String              @id @default(cuid())
  source                     String
  externalId                 String
  title                      String
  description                String?
  customerName               String
  customerBin                String
  category                   String
  industryTags               String[]
  procurementMethod          ProcurementMethod   @default(OPEN_TENDER)
  amount                     Float
  currency                   String              @default("KZT")
  region                     String
  publishDate                DateTime
  deadlineDate               DateTime
  applicationSecurityAmount Float?
  applicationSecurityPercent Float?
  status                     TenderStatus        @default(ACTIVE)
  sourceUrl                  String
  aiSummary                  String?
  aiKeyRequirements          String[]
  riskScore                  Int                 @default(0)
  riskScoringStatus          RiskScoringStatus   @default(NOT_SCORED)
  createdAt                  DateTime            @default(now())
  updatedAt                  DateTime            @updatedAt

  riskFlags                  RiskFlag[]
  documents                  TenderDocument[]
  history                    TenderAuditTrail[]
  kanbanCards                KanbanCard[]
  calculations               TenderCalculation[]
  generatedDocs              GeneratedDocument[]
  requirements               TenderRequirementItem[]
  securityInstruments        SecurityInstrument[]
  contractExecution          ContractExecution?
  deadlines                  TenderDeadline[]

  @@unique([source, externalId])
}

model RiskFlag {
  id          String   @id @default(cuid())
  tenderId    String
  tender      Tender   @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  title       String
  description String
  severity    String   @default("MEDIUM")
  createdAt   DateTime @default(now())
}

model TenderDocument {
  id            String   @id @default(cuid())
  tenderId      String
  tender        Tender   @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  fileName      String
  fileUrl       String
  fileSize      String?
  docType       String   @default("TECHNICAL_SPEC")
  extractedText String?  @db.Text
  createdAt     DateTime @default(now())
}

model TenderAuditTrail {
  id        String   @id @default(cuid())
  tenderId  String
  tender    Tender   @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  field     String
  oldValue  String?
  newValue  String?
  changedBy String   @default("System Parser")
  timestamp DateTime @default(now())
}

model DataSource {
  id                String               @id @default(cuid())
  name              String               @unique
  displayName       String
  adapterType       DataSourceType       @default(API)
  isActive          Boolean              @default(true)
  checkIntervalMins Int                  @default(15)
  lastSyncAt        DateTime?
  healthStatus      HealthStatus         @default(HEALTHY)
  successRate24h    Float                @default(100.0)
  totalIngested     Int                  @default(0)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  logs              ConnectorLog[]
  scraperConfig     ScraperSourceConfig?
}

model ScraperSourceConfig {
  id               String            @id @default(cuid())
  dataSourceId     String            @unique
  dataSource       DataSource        @relation(fields: [dataSourceId], references: [id], onDelete: Cascade)
  renderMode       ScraperRenderMode @default(STATIC)
  listUrlTemplate  String
  pagination       Json
  listItemSelector String
  fields           Json
  detailPage       Json?
  respectRobotsTxt Boolean           @default(true)
  active           Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model ConnectorLog {
  id           String     @id @default(cuid())
  sourceId     String
  dataSource   DataSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  status       String
  message      String
  itemsFetched Int        @default(0)
  executionMs  Int        @default(0)
  timestamp    DateTime   @default(now())
}

model Organization {
  id                    String   @id @default(cuid())
  name                  String
  bin                   String?  @unique
  subscriptionPlan      String   @default("FREE")
  subscriptionExpiresAt DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  members               OrganizationMember[]
  companyProfiles       CompanyProfile[]
  kanbanCards           KanbanCard[]
  payments              Payment[]
  calculations          TenderCalculation[]
  aiTokenUsages         AiTokenUsage[]
  documentTemplates     DocumentTemplate[]
}

model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("MEMBER") // OWNER, ADMIN, MEMBER
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
}

model AiTokenUsage {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  tenderId       String?
  provider       String        @default("Google Gemini")
  model          String        @default("gemini-1.5-flash")
  tokensUsed     Int
  tokensIn       Int           @default(0)
  tokensOut      Int           @default(0)
  costUsd        Float         @default(0.0)
  contentHash    String?
  operation      String
  timestamp      DateTime      @default(now())

  @@index([organizationId])
  @@index([timestamp])
  @@index([contentHash])
}

model CompanyProfile {
  id            String   @id @default(cuid())
  userId        String?  @unique
  user          User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  companyName   String
  bin           String   @unique
  activities    String
  keywords      String[]
  regions       String[]
  minAmount     Float    @default(0)
  maxAmount     Float?
  contactEmail  String
  telegramChatId String?
  subscriptionPlan String @default("FREE")
  subscriptionExpiresAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  calculations  TenderCalculation[]
  billingAuditLogs BillingAuditLog[]
  generatedDocs GeneratedDocument[]
  securityInstruments SecurityInstrument[]
  deadlines           TenderDeadline[]
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  passwordHash        String               @default("")
  emailVerifiedAt     DateTime?
  name                String?
  role                String               @default("USER")
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  payments            Payment[]
  companyProfile      CompanyProfile?
  orgMemberships      OrganizationMember[]
  kanbanCards         KanbanCard[]
  notificationSetting NotificationSetting?
  apiKeys             ApiKey[]
  sessions            Session[]
  loginAttempts       LoginAttempt[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime
  userAgent String?
  ipHash    String?

  @@index([userId])
  @@index([expiresAt])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  success   Boolean
  ipHash    String?
  createdAt DateTime @default(now())

  @@index([email, createdAt])
}

model ApiKey {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  keyHash     String    @unique
  keyPrefix   String
  label       String
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
}

model Payment {
  id                 String        @id @default(cuid())
  orderId            String        @unique
  kaspiTransactionId String?       @unique
  status             PaymentStatus @default(PENDING)
  amount             Float
  tariffPlanId       String
  userId             String?
  user               User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  organizationId     String?
  organization       Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  rawWebhookPayload  String?
  createdAt          DateTime      @default(now())
  confirmedAt        DateTime?
}

model KanbanCard {
  id             String        @id @default(cuid())
  userId         String?
  user           User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  tenderId       String
  tender         Tender        @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  stage          KanbanStage   @default(UNDER_REVIEW)
  priority       Priority      @default(MEDIUM)
  assignee       String?
  notes          String?
  stageEnteredAt DateTime      @default(now())
  stageSlaHours  Int?
  finalWinAmount Decimal?      @db.Decimal(18, 2)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model NotificationSetting {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  telegramNotify Boolean  @default(true)
  emailNotify    Boolean  @default(false)
  minRiskNotify  Int      @default(50)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

enum ReputationEntityType {
  CUSTOMER
  SUPPLIER
}

model ReputationCheck {
  id               String               @id @default(cuid())
  bin              String
  entityType       ReputationEntityType
  isBlacklisted    Boolean              @default(false)
  registryRecordId String?
  reason           String?
  banStartDate     DateTime?
  banEndDate       DateTime?
  rawResponse      Json?
  checkedAt        DateTime             @default(now())
  expiresAt        DateTime

  @@unique([bin, entityType])
  @@index([bin])
}

model TenderParticipationStat {
  id                 String            @id @default(cuid())
  category           String
  region             String
  procurementMethod  ProcurementMethod
  /// Note: Internal platform win rate proxy ratio (total/won), NOT actual participant count from procurement protocol
  avgParticipants    Float?
  sampleSize         Int               @default(0)
  wonCount           Int               @default(0)
  lostCount          Int               @default(0)
  updatedAt          DateTime          @updatedAt

  @@unique([category, region, procurementMethod])
}

model TenderCalculation {
  id                    String   @id @default(cuid())
  tenderId              String
  tender                Tender   @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  companyId             String
  company               CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)
  organizationId        String?
  organization          Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  startPrice            Decimal  @db.Decimal(18, 2)
  totalCost             Decimal  @db.Decimal(18, 2)
  targetMarginPct       Decimal  @db.Decimal(5, 2)
  minMarginPct          Decimal  @db.Decimal(5, 2)

  riskAdjustedMarginPct Decimal? @db.Decimal(5, 2)
  recommendedPrice      Decimal  @db.Decimal(18, 2)
  minAcceptablePrice    Decimal  @db.Decimal(18, 2)
  biddingRoomPct        Decimal? @db.Decimal(5, 2)
  biddingRoomAmount     Decimal? @db.Decimal(18, 2)

  costItems             TenderCostItem[]

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([tenderId, companyId])
  @@index([tenderId])
  @@index([companyId])
}

enum TenderCostCategory {
  PURCHASE
  LOGISTICS
  INSTALLATION
  WARRANTY_SERVICE
  LABOR
  BID_SECURITY
  PERFORMANCE_BOND
  PLATFORM_FEES
  OVERHEAD
  TAXES
  FX_RISK
  OTHER
}

enum TenderCostValueType {
  FIXED
  PERCENTAGE
}

model TenderCostItem {
  id            String              @id @default(cuid())
  calculationId String
  calculation   TenderCalculation   @relation(fields: [calculationId], references: [id], onDelete: Cascade)

  category      TenderCostCategory
  label         String
  valueType     TenderCostValueType
  amount        Decimal             @db.Decimal(18, 2)
  baseAmount    Decimal?            @db.Decimal(18, 2)
  computedAmount Decimal            @db.Decimal(18, 2)

  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([calculationId])
}

enum DataSourceStatus {
  HEALTHY
  WARNING
  FAILED
}

model DataSourceHealth {
  id                  String           @id @default(cuid())
  sourceName          String           @unique
  status              DataSourceStatus @default(HEALTHY)
  lastSuccessAt       DateTime         @default(now())
  lastErrorAt         DateTime?
  errorCount24h       Int              @default(0)
  tendersIngested24h  Int              @default(0)
  consecutiveFailures  Int              @default(0)
  lastErrorMessage    String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
}

model BillingAuditLog {
  id               String         @id @default(cuid())
  companyProfileId String
  companyProfile   CompanyProfile @relation(fields: [companyProfileId], references: [id], onDelete: Cascade)
  action           String
  oldPlan          String?
  newPlan          String
  reason           String
  performedBy      String
  createdAt        DateTime       @default(now())

  @@index([companyProfileId])
}

// ==========================================
// Phase 3: Operational Modules Schema
// ==========================================

enum DocTemplateFormat {
  DOCX
  PDF
}

model DocumentTemplate {
  id             String            @id @default(cuid())
  organizationId String?
  organization   Organization?     @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  name           String
  category       String            // "ALL" or lot category
  bodyTemplate   String            @db.Text
  outputFormat   DocTemplateFormat @default(DOCX)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  generatedDocs  GeneratedDocument[]
}

model GeneratedDocument {
  id               String           @id @default(cuid())
  tenderId         String
  tender           Tender           @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  templateId       String
  template         DocumentTemplate @relation(fields: [templateId], references: [id])
  companyProfileId String
  companyProfile   CompanyProfile   @relation(fields: [companyProfileId], references: [id], onDelete: Cascade)
  fileUrl          String
  generatedAt      DateTime         @default(now())
}

enum RequirementSource {
  AI_EXTRACTED
  MANUAL
}

model TenderRequirementItem {
  id          String            @id @default(cuid())
  tenderId    String
  tender      Tender            @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  label       String
  isCompleted Boolean           @default(false)
  completedBy String?
  completedAt DateTime?
  notes       String?
  sourceType  RequirementSource @default(AI_EXTRACTED)
  createdAt   DateTime          @default(now())
}

enum SecurityInstrumentType {
  BID_SECURITY_DEPOSIT
  BID_SECURITY_BANK_GUARANTEE
  PERFORMANCE_BOND_DEPOSIT
  PERFORMANCE_BOND_BANK_GUARANTEE
}

enum SecurityInstrumentStatus {
  ACTIVE
  RELEASED
  FORFEITED
  EXPIRED
}

model SecurityInstrument {
  id                 String                   @id @default(cuid())
  tenderId           String
  tender             Tender                   @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  companyProfileId   String
  companyProfile     CompanyProfile           @relation(fields: [companyProfileId], references: [id], onDelete: Cascade)

  type               SecurityInstrumentType
  amount             Decimal                  @db.Decimal(18, 2)
  issuedByBank       String?
  issueDate          DateTime
  expiryDate         DateTime
  status             SecurityInstrumentStatus @default(ACTIVE)
  releasedAt         DateTime?
  documentUrl        String?
  lastReminderSentAt DateTime?

  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  @@index([companyProfileId])
  @@index([expiryDate])
}

enum ContractExecutionStatus {
  IN_PROGRESS
  DELIVERED_ON_TIME
  DELIVERED_LATE
  PENALIZED
  TERMINATED
}

enum MilestoneStatus {
  PENDING
  DONE
  OVERDUE
}

model ContractExecution {
  id                 String                  @id @default(cuid())
  tenderId           String                  @unique
  tender             Tender                  @relation(fields: [tenderId], references: [id], onDelete: Cascade)

  contractSignedAt   DateTime?
  deliveryDeadline   DateTime
  actualDeliveryDate DateTime?
  status             ContractExecutionStatus @default(IN_PROGRESS)

  milestones         ContractMilestone[]

  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
}

model ContractMilestone {
  id          String            @id @default(cuid())
  contractId  String
  contract    ContractExecution @relation(fields: [contractId], references: [id], onDelete: Cascade)
  label       String
  dueDate     DateTime
  completedAt DateTime?
  status      MilestoneStatus   @default(PENDING)
}

enum DeadlineType {
  SUBMISSION_DEADLINE
  CLARIFICATION_DEADLINE
  SECURITY_DEPOSIT_DEADLINE
  APPEAL_DEADLINE
  CONTRACT_SIGNING_DEADLINE
  CUSTOM
}

enum DeadlineStatus {
  PENDING
  COMPLETED
  MISSED
  CANCELLED
}

model TenderDeadline {
  id             String         @id @default(cuid())
  tenderId       String
  tender         Tender         @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  companyId      String
  companyProfile CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type           DeadlineType
  dueAt          DateTime
  status         DeadlineStatus @default(PENDING)
  title          String?
  notifiedAt     DateTime?
  completedAt    DateTime?
  createdBy      String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([companyId, status, dueAt])
  @@index([tenderId])
}

model CustomerWinnerCache {
  id          String   @id @default(cuid())
  customerBin String
  winnerBin   String?
  winnerName  String?
  tenderCount Int      @default(0)
  sampleSize  Int      @default(0)
  checkedAt   DateTime @default(now())

  @@index([customerBin])
}






