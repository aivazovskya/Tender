# Database Connection (PostgreSQL)
# REQUIRED: Set POSTGRES_PASSWORD and DATABASE_URL before deployment. Container startup will intentionally fail if unconfigured.
POSTGRES_PASSWORD="change_me_before_deploy"
DATABASE_URL="postgresql://postgres:change_me_before_deploy@localhost:5432/tenderai?schema=public"

# Redis Connection (BullMQ)
REDIS_URL="redis://localhost:6379"

# Ingestion API Tokens
GOSZAKUP_API_TOKEN="your_goszakup_bearer_token_here"
SAMRUK_API_TOKEN="your_samruk_kazyna_token_here"

# AI / LLM Provider Configuration
LLM_API_KEY="your_openai_or_gemini_api_key_here"

# Telegram Bot Integration
TELEGRAM_BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ"

# Kaspi Pay Acquiring & Billing Security
# IMPORTANT: KASPI_WEBHOOK_SECRET must match the HMAC secret key configured in Kaspi Pay Merchant Dashboard
KASPI_WEBHOOK_SECRET="your_kaspi_webhook_hmac_secret_here"
KASPI_PAY_MERCHANT_ID="your_kaspi_merchant_id"

# Deadline & Appeal Configuration
# Statutory window for appealing tender results in working days (Law of RoK on Public Procurement, Art. 47)
APPEAL_WINDOW_DAYS="3"

# Internal Docker Networking & Cron
# In Docker Compose, the worker connects to the web container via internal network:
INTERNAL_APP_URL="http://web:3000"
# Secret for triggering and authenticating /api/cron/* and /api/notifications/* endpoints
CRON_SECRET="generate_random_secret_string_here"

# Security & Admin Access
ADMIN_API_KEY="generate_random_admin_api_key_here"
JWT_SECRET="generate_random_jwt_secret_here"
API_SECRET_KEY="generate_random_api_secret_key_here"

# Access Control & Demo Mode
# In production with pre-moderated registration, keep ALLOW_DEMO_AUTH disabled (false or unset).
# Only set to true if you explicitly want public anonymous demo access with demo-user-id.
ALLOW_DEMO_AUTH="false"

# Subscription & Billing Configuration
# When BILLING_ENABLED is false, Kaspi Pay acquiring is bypassed and all authenticated team users
# automatically receive ENTERPRISE tier with unlimited exports, RNU checks, calculation limits and REST API.
BILLING_ENABLED="false"
NEXT_PUBLIC_BILLING_ENABLED="false"



